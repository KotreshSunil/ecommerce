DATABASE_URL=postgresql://user:password@ep-example.region.aws.neon.tech/dbname?sslmode=require

# TiDB Serverless (MySQL-compatible) — get these from the "Connect" dialog
# of your cluster at https://tidbcloud.com
TIDB_HOST=gateway01.region.prod.aws.tidbcloud.com
TIDB_PORT=4000
TIDB_USER=user.root
TIDB_PASSWORD=password
TIDB_DATABASE=test

# Better Auth — generate a secret with:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
